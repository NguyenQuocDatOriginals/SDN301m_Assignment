<% include ../partials/header %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Dashboard</title>
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }

    th {
      background-color: #f2f2f2;
    }
  </style>
</head>

<body>
  <div class="ui main text container segment">
    <div class="ui huge header">Danh sách sản phẩm</div>
    <a href="/product/create" class="ui basic red button">Tạo sản phẩm mới</a>

    <% if (products && products.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Tên</th>
            <th>Mô tả</th>
            <th>Giá</th>
            <th>Danh mục</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <td><%= product.productName %></td>
              <td><%= product.productDescription %></td>
              <td><%= product.price %></td>
              <td><%= product.category ? product.category.categoryName : 'No Category' %></td>
              <td>
                <a href="/product/<%= product._id %>/edit" class="ui basic button">Sửa</a>
                <form action="/product/<%= product._id %>/delete" method="GET" 
                      style="display:inline;" 
                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                  <button type="submit" class="ui basic button">Xóa</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p>Không tìm thấy sản phẩm nào</p>
    <% } %>
  </div>
</body>

</html>